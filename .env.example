# === REQUIRED ===
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Public URL of this process (no trailing slash). Used for OAuth redirects & dashboard links.
# Example: https://omnibot.wisp.uno   or   http://YOUR_IP:PORT
PUBLIC_BASE_URL=https://omnibot.wisp.uno

# OAuth callback must match Discord Developer Portal → OAuth2 → Redirects exactly
# Default built as: {PUBLIC_BASE_URL}/auth/discord/callback
DISCORD_REDIRECT_URI=

# Wispbyte / host sets this. Bot + dashboard share this port.
PORT=13893

# Random long string for signed sessions (generate once and keep secret)
SESSION_SECRET=

# === AI (optional but needed for AI features) ===
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Home Mode / PixelForge image API (optional)
HOME_MODE_API_URL=
HOME_MODE_API_KEY=
HOME_MODE_API_PATH=/api/v1/generate

# GIF replies (optional)
TENOR_API_KEY=
GIPHY_API_KEY=

# Music metadata (optional — streams prefer SoundCloud, not YouTube)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US
SOUNDCLOUD_CLIENT_ID=

# CORS / dashboard origins (comma-separated). PUBLIC_BASE_URL is always allowed.
DASHBOARD_ORIGINS=https://omnibot.wisp.uno,http://localhost:5173

# Command prefix default (per-server overrideable in dashboard)
DEFAULT_PREFIX=!

# Daily AI requests per guild (fixed product limit)
AI_DAILY_LIMIT=20

# Optional TLS (leave empty for HTTP)
SSL_KEY_PATH=
SSL_CERT_PATH=
