# ============================================================
# OmniBot (Python) — environment variables for Wispbyte / VPS
# Copy to .env and fill in. NEVER commit real secrets.
# ============================================================

# --- REQUIRED: Discord bot ---
DISCORD_TOKEN=

# --- REQUIRED for dashboard login (OAuth2) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Public URL of this process (no trailing slash).
# Examples: https://omnibot.wisp.uno   or   http://YOUR_IP:13893
PUBLIC_BASE_URL=https://omnibot.wisp.uno

# Must match Discord Developer Portal → OAuth2 → Redirects EXACTLY
# Default if empty: {PUBLIC_BASE_URL}/auth/discord/callback
DISCORD_REDIRECT_URI=

# Host / Wispbyte injects PORT. Bot + dashboard share it.
PORT=13893
# SERVER_PORT=13893

# Long random string for session cookies (generate once, keep secret)
SESSION_SECRET=

# --- AI (required for /ask /chat /imagine AI features) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional aliases also accepted: GROQ_KEY, GROQ_TOKEN
AI_DAILY_LIMIT=20

# --- Image generation (Home Mode / PixelForge) ---
HOME_MODE_API_URL=
HOME_MODE_API_KEY=
HOME_MODE_API_PATH=/api/v1/generate

# --- Optional GIFs in AI replies ---
TENOR_API_KEY=
GIPHY_API_KEY=

# --- Music metadata (optional; streams prefer SoundCloud, not YouTube) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US
SOUNDCLOUD_CLIENT_ID=

# --- CORS / browser origins (comma-separated). PUBLIC_BASE_URL always allowed ---
DASHBOARD_ORIGINS=https://omnibot.wisp.uno,http://localhost:5173

# --- Bot behaviour defaults ---
DEFAULT_PREFIX=!

# Optional data directory (default: ./data)
# DATA_DIR=/home/container/data

# Optional TLS files (leave empty for HTTP)
SSL_KEY_PATH=
SSL_CERT_PATH=
