# ============================================================
# OmniBot (Python) — Discord only
# Copy to .env and fill in. NEVER commit real secrets.
# ============================================================

# --- REQUIRED: Discord bot token ---
DISCORD_TOKEN=

# --- REQUIRED for dashboard login (OAuth2) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

PUBLIC_BASE_URL=https://omnibot.wisp.uno
DISCORD_REDIRECT_URI=

PORT=13893
SESSION_SECRET=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_DAILY_LIMIT=20

HOME_MODE_API_URL=
HOME_MODE_API_KEY=
HOME_MODE_API_PATH=/api/v1/generate

TENOR_API_KEY=
GIPHY_API_KEY=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US
SOUNDCLOUD_CLIENT_ID=

DASHBOARD_ORIGINS=https://omnibot.wisp.uno,http://localhost:5173

# Optional
# DATA_DIR=/home/container/data
# FORCE_COMMAND_SYNC=false
# SSL_KEY_PATH=
# SSL_CERT_PATH=
